# ─────────────────────────────────────────────────────────────────────────────
# Prime Capital & Investment Ltd — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in every value below
#   3. NEVER commit .env to Git (it is in .gitignore)
#
# NOTE: this replaces the earlier Azure/SendGrid version. The project now uses
# Supabase for storage and Resend for email. Azure Blob, SendGrid, Redis and
# Celery variables have been removed because nothing in the code reads them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Prime Capital & Investment Ltd"
APP_ENV=development                        # development | staging | production
APP_DEBUG=true                             # false in production
APP_URL=http://localhost:8000              # Backend URL

# Where the React app is served. Used for CORS, and to build the links inside
# password reset and email verification emails. If this is wrong, those emails
# point clients at the wrong host.
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://portal.primecapital.ng

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value in production than in development.
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/primecapital
#
# Supabase: take the "Connection pooling" URI from
# Project Settings > Database > Connection string, then change the
# postgresql:// prefix to postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ── File storage ──────────────────────────────────────────────────────────────
# "local"    writes to app/static/. Development only: most cloud hosts wipe
#            this directory on every deploy, so uploaded KYC documents and
#            client avatars would silently disappear after a release.
# "supabase" stores files durably in Supabase Storage.
STORAGE_BACKEND=local

# Only needed when STORAGE_BACKEND=supabase.
# Use the SERVICE ROLE key, not the anon key.
# The bucket must be PRIVATE: documents are streamed to staff through an
# authenticated endpoint, so nothing requires public access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=pcil-uploads

# ── Email (Resend) ────────────────────────────────────────────────────────────
# "log"  prints emails to the server console instead of sending. Safe default
#        for development, but clients receive NOTHING: password reset and
#        email verification will appear broken to real users.
# "smtp" sends for real.
EMAIL_BACKEND=log

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=Prime Capital <noreply@primecapital.ng>
SMTP_USE_TLS=true

# ── Microsoft Dynamics 365 (not yet integrated) ──────────────────────────────
# There is no live D365 integration. Staff key submissions in manually using
# the KYC PDF export. These are kept as placeholders for future work.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# D365_BASE_URL=https://yourorg.crm.dynamics.com/api/data/v9.2
# D365_WEBHOOK_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
# First super admin account, created on first run by app/db/seed.py.
# Change the password immediately after first login in production.
SUPER_ADMIN_EMAIL=admin@primecapital.ng
SUPER_ADMIN_PASSWORD=ChangeThisImmediately!
SUPER_ADMIN_NAME=Saidu Safiyanu
